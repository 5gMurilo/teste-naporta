{
	"name": "teste-naporta",
	"private": true,
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"format": "turbo run format",
		"format:check": "turbo run format:check",
		"typecheck": "turbo run typecheck",
		"test:unit": "turbo run test:unit",
		"test:coverage": "turbo run test:coverage",
		"test:contract": "turbo run test:contract",
		"test:e2e": "turbo run test:e2e",
		"test:e2e:web": "turbo run test:e2e:web",
		"test:containers": "node scripts/test-containers.mjs",
		"test:scripts": "node --test scripts/*.test.mjs",
		"check": "node scripts/check.mjs",
		"test:integration": "turbo run test:integration",
		"prisma:generate": "turbo run prisma:generate",
		"prisma:validate": "turbo run prisma:validate",
		"start:prod": "turbo run start:prod --filter=@naporta/api",
		"db:generate": "turbo run db:generate",
		"db:migrate:dev": "turbo run db:migrate:dev",
		"db:migrate:deploy": "turbo run db:migrate:deploy",
		"db:seed": "pnpm --filter @naporta/api db:seed",
		"docs:openapi": "turbo run docs:openapi",
		"docs:openapi:check": "turbo run docs:openapi:check"
	},
	"devDependencies": {
		"turbo": "2.9.0"
	}
}

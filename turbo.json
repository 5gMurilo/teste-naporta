{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"passThroughEnv": ["DATABASE_URL"],
			"outputs": ["dist/**", "src/generated/**"]
		},
		"lint": { "cache": false },
		"lint:fix": { "cache": false },
		"typecheck": {
			"dependsOn": ["^typecheck", "prisma:generate"],
			"outputs": []
		},
		"test:unit": { "cache": false, "dependsOn": ["prisma:generate"] },
		"test:coverage": { "cache": false, "dependsOn": ["prisma:generate"] },
		"test:workspace": { "cache": false },
		"test:contract": { "cache": false, "dependsOn": ["prisma:generate"] },
		"test:e2e": { "cache": false, "dependsOn": ["prisma:generate"] },
		"test:integration": { "cache": false, "dependsOn": ["prisma:generate"] },
		"prisma:generate": { "cache": false, "passThroughEnv": ["DATABASE_URL"] },
		"prisma:validate": { "cache": false, "passThroughEnv": ["DATABASE_URL"] },
		"start:prod": { "cache": false, "persistent": true, "dependsOn": ["build"] },
		"db:generate": { "cache": false, "passThroughEnv": ["DATABASE_URL"] },
		"db:migrate:dev": { "cache": false, "interactive": true },
		"db:migrate:deploy": { "cache": false },
		"docs:openapi": { "cache": false },
		"docs:openapi:check": { "cache": false },
		"format": { "cache": false },
		"format:check": { "cache": false },
		"dev": { "cache": false, "persistent": true }
	}
}

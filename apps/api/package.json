{
  "name": "@naporta/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "pnpm prisma:generate && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js)",
    "start:dev": "pnpm dev",
    "start:prod": "node dist/main.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs",
    "test:unit": "pnpm test --runInBand && pnpm test:workspace",
    "test:workspace": "node --test test/workspace/*.test.mjs",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --runInBand --coverage",
    "test:contract": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-contract.config.cjs",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.config.cjs",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-integration.config.cjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "docs:openapi": "DATABASE_URL=postgresql://docs:docs@localhost:5432/docs pnpm build && node dist/docs/export-openapi.js",
    "docs:openapi:check": "DATABASE_URL=postgresql://docs:docs@localhost:5432/docs pnpm build && node dist/docs/export-openapi.js --check"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.8",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "redis": "6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@jest/globals": "30.5.2",
    "@nestjs/testing": "^12.2.0",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}

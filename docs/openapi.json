{
  "components": {
    "schemas": {
      "FieldError": {
        "properties": {
          "field": {
            "description": "Dotted path of the invalid field.",
            "example": "email",
            "type": "string"
          },
          "message": {
            "description": "Message without input values.",
            "example": "Invalid email address",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "description": "Email address; trimmed and lowercased.",
            "example": "demo@example.com",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "type": "string"
          },
          "password": {
            "description": "Password; never trimmed.",
            "example": "a-strong-demo-password",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "LoginResponse": {
        "additionalProperties": false,
        "example": {
          "accessToken": "eyJhbGciOiJIUzI1NiJ9...",
          "expiresIn": 3600,
          "tokenType": "Bearer"
        },
        "properties": {
          "accessToken": {
            "description": "Signed HS256 JWT.",
            "type": "string"
          },
          "expiresIn": {
            "description": "Token lifetime in seconds.",
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "tokenType": {
            "enum": [
              "Bearer"
            ],
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "code": {
            "example": "SERVICE_UNAVAILABLE",
            "type": "string"
          },
          "detail": {
            "example": "The service is temporarily unavailable.",
            "type": "string"
          },
          "instance": {
            "description": "Request path without the query string.",
            "example": "/api/v1/health",
            "type": "string"
          },
          "requestId": {
            "example": "5f0d1b0e-3f0e-4a56-8b57-3d9d6f9c2a10",
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "example": 503,
            "type": "number"
          },
          "title": {
            "description": "HTTP status phrase.",
            "example": "Service Unavailable",
            "type": "string"
          },
          "type": {
            "enum": [
              "about:blank"
            ],
            "example": "about:blank",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "requestId"
        ],
        "type": "object"
      },
      "ValidationProblemDetails": {
        "properties": {
          "code": {
            "example": "SERVICE_UNAVAILABLE",
            "type": "string"
          },
          "detail": {
            "example": "The service is temporarily unavailable.",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "instance": {
            "description": "Request path without the query string.",
            "example": "/api/v1/health",
            "type": "string"
          },
          "requestId": {
            "example": "5f0d1b0e-3f0e-4a56-8b57-3d9d6f9c2a10",
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "example": 503,
            "type": "number"
          },
          "title": {
            "description": "HTTP status phrase.",
            "example": "Service Unavailable",
            "type": "string"
          },
          "type": {
            "enum": [
              "about:blank"
            ],
            "example": "about:blank",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "requestId",
          "errors"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Orders API with JWT authentication, filters, pagination, and soft delete.",
    "title": "naPorta Orders API",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Bearer token for the demo user."
          },
          "400": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "VALIDATION_ERROR",
                  "detail": "The request is invalid.",
                  "errors": [
                    {
                      "field": "email",
                      "message": "Invalid email address"
                    }
                  ],
                  "instance": "/api/v1/auth/login",
                  "requestId": "5f0d1b0e-3f0e-4a56-8b57-3d9d6f9c2a10",
                  "status": 400,
                  "title": "Bad Request",
                  "type": "about:blank"
                },
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            },
            "description": "Invalid or unknown body properties."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "INVALID_CREDENTIALS",
                  "detail": "Invalid email or password.",
                  "instance": "/api/v1/auth/login",
                  "requestId": "5f0d1b0e-3f0e-4a56-8b57-3d9d6f9c2a10",
                  "status": 401,
                  "title": "Unauthorized",
                  "type": "about:blank"
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unknown email or wrong password; both cases are indistinguishable."
          },
          "500": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "INTERNAL_SERVER_ERROR",
                  "detail": "An unexpected error occurred.",
                  "instance": "/api/v1/auth/login",
                  "requestId": "5f0d1b0e-3f0e-4a56-8b57-3d9d6f9c2a10",
                  "status": 500,
                  "title": "Internal Server Error",
                  "type": "about:blank"
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected failure."
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "database": "up",
                  "status": "ok"
                },
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "database": {
                      "enum": [
                        "up"
                      ],
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "ok"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "database"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The API is running and PostgreSQL answered a real query."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "SERVICE_UNAVAILABLE",
                  "detail": "The service is temporarily unavailable.",
                  "instance": "/api/v1/health",
                  "requestId": "5f0d1b0e-3f0e-4a56-8b57-3d9d6f9c2a10",
                  "status": 503,
                  "title": "Service Unavailable",
                  "type": "about:blank"
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "PostgreSQL is unavailable."
          }
        },
        "tags": [
          "health"
        ]
      }
    }
  },
  "servers": [],
  "tags": []
}

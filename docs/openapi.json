{
  "components": {
    "schemas": {
      "CreateOrderRequest": {
        "additionalProperties": false,
        "example": {
          "customer": {
            "document": "123.456.789-00",
            "name": "Ana Silva"
          },
          "deliveryAddress": {
            "city": "São Paulo",
            "complement": "Apto 12",
            "neighborhood": "Centro",
            "number": "101",
            "postalCode": "01001000",
            "state": "SP",
            "street": "Rua das Flores"
          },
          "expectedDeliveryDate": "2026-11-03",
          "items": [
            {
              "description": "Café especial",
              "priceCents": 4990
            },
            {
              "description": "Caneca",
              "priceCents": 0
            }
          ],
          "orderNumber": "NP-2026-0001"
        },
        "properties": {
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "deliveryAddress": {
            "$ref": "#/components/schemas/DeliveryAddress"
          },
          "expectedDeliveryDate": {
            "example": "2026-11-03",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItemInput"
            },
            "maxItems": 50,
            "minItems": 1,
            "type": "array"
          },
          "orderNumber": {
            "example": "NP-2026-0001",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "description": "Defaults to PENDING.",
            "enum": [
              "PENDING",
              "PROCESSING",
              "SHIPPED",
              "DELIVERED",
              "CANCELED"
            ],
            "type": "string"
          }
        },
        "required": [
          "orderNumber",
          "expectedDeliveryDate",
          "customer",
          "deliveryAddress",
          "items"
        ],
        "type": "object"
      },
      "Customer": {
        "additionalProperties": false,
        "properties": {
          "document": {
            "description": "Free-form document; no CPF/CNPJ algorithm.",
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "example": "Ana Silva",
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "document"
        ],
        "type": "object"
      },
      "DeliveryAddress": {
        "additionalProperties": false,
        "properties": {
          "city": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "complement": {
            "maxLength": 100,
            "type": "string"
          },
          "neighborhood": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "number": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "postalCode": {
            "example": "01001000",
            "pattern": "^\\d{8}$",
            "type": "string"
          },
          "state": {
            "example": "SP",
            "pattern": "^[A-Z]{2}$",
            "type": "string"
          },
          "street": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "street",
          "number",
          "neighborhood",
          "city",
          "state",
          "postalCode"
        ],
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "field": {
            "description": "Dotted path of the invalid field.",
            "example": "email",
            "type": "string"
          },
          "message": {
            "description": "Message without input values.",
            "example": "Invalid email address",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "type": "object"
      },
      "ListOrdersResponse": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/OrderSummaryResponse"
            },
            "type": "array"
          },
          "meta": {
            "additionalProperties": false,
            "properties": {
              "page": {
                "maximum": 9007199254740991,
                "minimum": 1,
                "type": "integer"
              },
              "pageSize": {
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              },
              "total": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "totalPages": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "page",
              "pageSize",
              "total",
              "totalPages"
            ],
            "type": "object"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "description": "Email address; trimmed and lowercased.",
            "example": "demo@example.com",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "type": "string"
          },
          "password": {
            "description": "Password; never trimmed.",
            "example": "a-strong-demo-password",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "LoginResponse": {
        "additionalProperties": false,
        "example": {
          "accessToken": "eyJhbGciOiJIUzI1NiJ9...",
          "expiresIn": 3600,
          "tokenType": "Bearer"
        },
        "properties": {
          "accessToken": {
            "description": "Signed HS256 JWT.",
            "type": "string"
          },
          "expiresIn": {
            "description": "Token lifetime in seconds.",
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "tokenType": {
            "enum": [
              "Bearer"
            ],
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn"
        ],
        "type": "object"
      },
      "OrderItem": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          },
          "priceCents": {
            "maximum": 2000000000,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "description",
          "priceCents"
        ],
        "type": "object"
      },
      "OrderItemInput": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "example": "Café especial",
            "maxLength": 240,
            "minLength": 1,
            "type": "string"
          },
          "priceCents": {
            "description": "Price in BRL cents.",
            "example": 4990,
            "maximum": 2000000000,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "description",
          "priceCents"
        ],
        "type": "object"
      },
      "OrderResponse": {
        "additionalProperties": false,
        "example": {
          "createdAt": "2026-10-21T12:30:45.123Z",
          "customer": {
            "document": "123.456.789-00",
            "name": "Ana Silva"
          },
          "deliveryAddress": {
            "city": "São Paulo",
            "complement": "Apto 12",
            "neighborhood": "Centro",
            "number": "101",
            "postalCode": "01001000",
            "state": "SP",
            "street": "Rua das Flores"
          },
          "expectedDeliveryDate": "2026-11-03",
          "id": "6c0b1c32-8b4d-4f43-8c1b-0d4cf4fd7a6b",
          "items": [
            {
              "description": "Café especial",
              "id": "1b4e28ba-2fa1-4d3b-a3fd-27d4f4b9d0a1",
              "priceCents": 4990
            },
            {
              "description": "Caneca",
              "id": "2c5f39cb-3fb2-4e4c-b4ae-38e5a5c0e1b2",
              "priceCents": 0
            }
          ],
          "orderNumber": "NP-2026-0001",
          "status": "PENDING",
          "totalCents": 4990,
          "updatedAt": "2026-10-21T12:30:45.123Z"
        },
        "properties": {
          "createdAt": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "type": "string"
          },
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "deliveryAddress": {
            "$ref": "#/components/schemas/DeliveryAddress"
          },
          "expectedDeliveryDate": {
            "example": "2026-11-03",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            },
            "type": "array"
          },
          "orderNumber": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PENDING",
              "PROCESSING",
              "SHIPPED",
              "DELIVERED",
              "CANCELED"
            ],
            "type": "string"
          },
          "totalCents": {
            "description": "Sum of item prices in BRL cents; calculated, not stored.",
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "updatedAt": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "orderNumber",
          "status",
          "expectedDeliveryDate",
          "customer",
          "deliveryAddress",
          "items",
          "totalCents",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "OrderSummaryResponse": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "type": "string"
          },
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "expectedDeliveryDate": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          },
          "orderNumber": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PENDING",
              "PROCESSING",
              "SHIPPED",
              "DELIVERED",
              "CANCELED"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "orderNumber",
          "status",
          "expectedDeliveryDate",
          "customer",
          "createdAt"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "code": {
            "example": "SERVICE_UNAVAILABLE",
            "type": "string"
          },
          "detail": {
            "example": "The service is temporarily unavailable.",
            "type": "string"
          },
          "instance": {
            "description": "Request path without the query string.",
            "example": "/api/v1/health",
            "type": "string"
          },
          "requestId": {
            "example": "5f0d1b0e-3f0e-4a56-8b57-3d9d6f9c2a10",
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "example": 503,
            "type": "number"
          },
          "title": {
            "description": "HTTP status phrase.",
            "example": "Service Unavailable",
            "type": "string"
          },
          "type": {
            "enum": [
              "about:blank"
            ],
            "example": "about:blank",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "requestId"
        ],
        "type": "object"
      },
      "UpdateOrderRequest": {
        "additionalProperties": false,
        "example": {
          "status": "SHIPPED"
        },
        "properties": {
          "customer": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Customer"
              }
            ]
          },
          "deliveryAddress": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DeliveryAddress"
              }
            ]
          },
          "expectedDeliveryDate": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItemInput"
            },
            "maxItems": 50,
            "minItems": 1,
            "type": "array"
          },
          "orderNumber": {
            "example": "NP-2026-0001",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "PENDING",
              "PROCESSING",
              "SHIPPED",
              "DELIVERED",
              "CANCELED"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "ValidationProblemDetails": {
        "properties": {
          "code": {
            "example": "SERVICE_UNAVAILABLE",
            "type": "string"
          },
          "detail": {
            "example": "The service is temporarily unavailable.",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "instance": {
            "description": "Request path without the query string.",
            "example": "/api/v1/health",
            "type": "string"
          },
          "requestId": {
            "example": "5f0d1b0e-3f0e-4a56-8b57-3d9d6f9c2a10",
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "example": 503,
            "type": "number"
          },
          "title": {
            "description": "HTTP status phrase.",
            "example": "Service Unavailable",
            "type": "string"
          },
          "type": {
            "enum": [
              "about:blank"
            ],
            "example": "about:blank",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "requestId",
          "errors"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Orders API with JWT authentication, filters, pagination, and soft delete.",
    "title": "naPorta Orders API",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Bearer token for the demo user."
          },
          "400": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "VALIDATION_ERROR",
                  "detail": "The request is invalid.",
                  "errors": [
                    {
                      "field": "email",
                      "message": "Invalid email address"
                    }
                  ],
                  "instance": "/api/v1/auth/login",
                  "requestId": "5f0d1b0e-3f0e-4a56-8b57-3d9d6f9c2a10",
                  "status": 400,
                  "title": "Bad Request",
                  "type": "about:blank"
                },
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            },
            "description": "Invalid or unknown body properties."
          },
          "401": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "INVALID_CREDENTIALS",
                  "detail": "Invalid email or password.",
                  "instance": "/api/v1/auth/login",
                  "requestId": "5f0d1b0e-3f0e-4a56-8b57-3d9d6f9c2a10",
                  "status": 401,
                  "title": "Unauthorized",
                  "type": "about:blank"
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unknown email or wrong password; both cases are indistinguishable."
          },
          "500": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "INTERNAL_SERVER_ERROR",
                  "detail": "An unexpected error occurred.",
                  "instance": "/api/v1/auth/login",
                  "requestId": "5f0d1b0e-3f0e-4a56-8b57-3d9d6f9c2a10",
                  "status": 500,
                  "title": "Internal Server Error",
                  "type": "about:blank"
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unexpected failure."
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "database": "up",
                  "status": "ok"
                },
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "database": {
                      "enum": [
                        "up"
                      ],
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "ok"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "database"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The API is running and PostgreSQL answered a real query."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "SERVICE_UNAVAILABLE",
                  "detail": "The service is temporarily unavailable.",
                  "instance": "/api/v1/health",
                  "requestId": "5f0d1b0e-3f0e-4a56-8b57-3d9d6f9c2a10",
                  "status": 503,
                  "title": "Service Unavailable",
                  "type": "about:blank"
                },
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "PostgreSQL is unavailable."
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/orders": {
      "get": {
        "operationId": "OrdersController_list",
        "parameters": [
          {
            "in": "query",
            "name": "orderNumber",
            "required": false,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": [
                "PENDING",
                "PROCESSING",
                "SHIPPED",
                "DELIVERED",
                "CANCELED"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "createdFrom",
            "required": false,
            "schema": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "createdTo",
            "required": false,
            "schema": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            }
          },
          {
            "description": "Page number, starting at 1. Defaults to 1.",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "description": "Page number, starting at 1. Defaults to 1.",
              "example": "1",
              "pattern": "^\\d+$",
              "type": "string"
            }
          },
          {
            "description": "Items per page, 1 to 100. Defaults to 20.",
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "description": "Items per page, 1 to 100. Defaults to 20.",
              "example": "20",
              "pattern": "^\\d+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListOrdersResponse"
                }
              }
            },
            "description": "Active orders matching every filter (AND), newest first. Pages past the end return an empty list."

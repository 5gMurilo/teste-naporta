NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teste_naporta
PORT=3000

# Generate a unique value with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=naporta
JWT_AUDIENCE=naporta-web
JWT_EXPIRES_IN=3600

REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60
CACHE_TIMEOUT_MS=200

# Optional. Keep this to one explicit origin; do not use '*'.
# CORS_ORIGIN=https://app.example.com

# Required only when running the explicit seed command.
# SEED_USER_EMAIL=demo@example.com
# SEED_USER_PASSWORD=replace-with-a-non-empty-password

# Web app (optional, development only). VITE_ variables are compiled into the public bundle:
# never put secrets in them.
# DEV_PROXY_TARGET=http://localhost:3000
# VITE_API_BASE_URL=

# Docker Compose (docker compose up -d --build). JWT_SECRET is required; the rest has defaults.
# POSTGRES_PORT=5432
# POSTGRES_PASSWORD=postgres
# API_PORT=3000
# WEB_PORT=8080
